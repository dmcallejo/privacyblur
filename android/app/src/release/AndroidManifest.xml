<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- PrivacyBlur works fully offline. Libraries (for example ML Kit in the
         full flavor) may request network access for their own telemetry, so
         the permissions are stripped from release builds. Debug and profile
         builds keep INTERNET, which Flutter needs for hot reload. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
</manifest>
